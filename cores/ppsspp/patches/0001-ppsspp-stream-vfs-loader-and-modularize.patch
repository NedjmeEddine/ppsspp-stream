diff --git i/Core/FileLoaders/WasmVfsFileLoader.cpp w/Core/FileLoaders/WasmVfsFileLoader.cpp
new file mode 100644
index 0000000..f89a624
--- /dev/null
+++ w/Core/FileLoaders/WasmVfsFileLoader.cpp
@@ -0,0 +1,153 @@
+// Copyright (c) 2012- PPSSPP Project / PPSSPP-Stream Contributors.
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+#include "Core/FileLoaders/WasmVfsFileLoader.h"
+
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <mutex>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#endif
+
+namespace {
+
+constexpr size_t VFS_IPC_MAX_READ_BYTES = 524288; // 512 KiB
+
+struct alignas(64) VfsIpcMailbox {
+	std::atomic<int32_t> req_futex{0};                 // offset 0
+	std::atomic<int32_t> resp_futex{0};                // offset 4
+	std::atomic<int32_t> op{0};                        // offset 8  (0=IDLE, 1=READ)
+	std::atomic<int32_t> status{0};                    // offset 12 (0=PENDING, 1=OK, -1=ERR_EOF_IO, -2=ERR_BUILD_ROTATED, -3=ERR_ABORTED)
+	std::atomic<int32_t> abort_flag{0};                // offset 16
+	std::atomic<uint32_t> len{0};                      // offset 20
+	std::atomic<uint64_t> offset{0};                   // offset 24
+	std::atomic<uint64_t> disc_size{0};                // offset 32
+	uint8_t padding[24]{};                             // offset 40..63
+	uint8_t payload[VFS_IPC_MAX_READ_BYTES]{};         // offset 64..524351
+};
+
+static_assert(sizeof(VfsIpcMailbox) == 64 + VFS_IPC_MAX_READ_BYTES, "VfsIpcMailbox size mismatch");
+
+alignas(64) VfsIpcMailbox g_ipc_mailbox;
+std::mutex g_vfs_ipc_mutex;
+
+} // namespace
+
+WasmVfsFileLoader::WasmVfsFileLoader(const Path &filename) : filename_(filename) {}
+
+bool WasmVfsFileLoader::Exists() {
+	return g_ipc_mailbox.disc_size.load(std::memory_order_acquire) > 0;
+}
+
+s64 WasmVfsFileLoader::FileSize() {
+	return static_cast<s64>(g_ipc_mailbox.disc_size.load(std::memory_order_acquire));
+}
+
+size_t WasmVfsFileLoader::ReadAt(s64 absolutePos, size_t bytes, size_t count, void *data, Flags /*flags*/) {
+#ifdef __EMSCRIPTEN__
+	if (emscripten_is_main_runtime_thread()) {
+		return 0;
+	}
+#endif
+	if (absolutePos < 0 || bytes == 0 || count == 0 || !data) {
+		return 0;
+	}
+	if (count > SIZE_MAX / bytes) {
+		return 0;
+	}
+	const size_t requestedTotal = bytes * count;
+	const uint64_t discSize = g_ipc_mailbox.disc_size.load(std::memory_order_acquire);
+	const uint64_t startOffset = static_cast<uint64_t>(absolutePos);
+	if (startOffset >= discSize) {
+		return 0;
+	}
+	const uint64_t remaining = discSize - startOffset;
+	const size_t totalBytes = (requestedTotal > remaining)
+		? static_cast<size_t>((remaining / bytes) * bytes)
+		: requestedTotal;
+	if (totalBytes == 0) {
+		return 0;
+	}
+
+	std::lock_guard<std::mutex> lock(g_vfs_ipc_mutex);
+
+	size_t done = 0;
+	auto *dst = static_cast<uint8_t *>(data);
+	while (done < totalBytes) {
+		if (g_ipc_mailbox.abort_flag.load(std::memory_order_acquire) != 0 ||
+		    cancelled_.load(std::memory_order_acquire)) {
+			return 0;
+		}
+		const size_t chunk = std::min(totalBytes - done, VFS_IPC_MAX_READ_BYTES);
+		const int32_t expectedSeq = g_ipc_mailbox.resp_futex.load(std::memory_order_acquire);
+
+		g_ipc_mailbox.offset.store(startOffset + done, std::memory_order_relaxed);
+		g_ipc_mailbox.len.store(static_cast<uint32_t>(chunk), std::memory_order_relaxed);
+		g_ipc_mailbox.status.store(0, std::memory_order_relaxed);
+		g_ipc_mailbox.op.store(1, std::memory_order_release);
+		g_ipc_mailbox.req_futex.fetch_add(1, std::memory_order_acq_rel);
+#ifdef __EMSCRIPTEN__
+		emscripten_futex_wake((volatile void *)&g_ipc_mailbox.req_futex, 1);
+
+		while (true) {
+			const int32_t seq = g_ipc_mailbox.resp_futex.load(std::memory_order_acquire);
+			if (g_ipc_mailbox.abort_flag.load(std::memory_order_acquire) != 0 ||
+			    cancelled_.load(std::memory_order_acquire)) {
+				return 0;
+			}
+			if (seq != expectedSeq && g_ipc_mailbox.op.load(std::memory_order_acquire) == 0) {
+				break;
+			}
+			emscripten_futex_wait((volatile void *)&g_ipc_mailbox.resp_futex, static_cast<uint32_t>(seq), 100.0);
+		}
+#else
+		return 0;
+#endif
+		const int32_t st = g_ipc_mailbox.status.load(std::memory_order_acquire);
+		if (st != 1) {
+			return 0;
+		}
+		std::memcpy(dst + done, g_ipc_mailbox.payload, chunk);
+		done += chunk;
+	}
+
+	return done / bytes;
+}
+
+extern "C" {
+
+#ifdef __EMSCRIPTEN__
+EMSCRIPTEN_KEEPALIVE
+#endif
+uintptr_t ppsspp_stream_get_ipc_ptr() {
+	return reinterpret_cast<uintptr_t>(&g_ipc_mailbox);
+}
+
+#ifdef __EMSCRIPTEN__
+EMSCRIPTEN_KEEPALIVE
+#endif
+void ppsspp_stream_set_disc_size(uint64_t size) {
+	g_ipc_mailbox.abort_flag.store(0, std::memory_order_release);
+	g_ipc_mailbox.op.store(0, std::memory_order_release);
+	g_ipc_mailbox.status.store(0, std::memory_order_release);
+	g_ipc_mailbox.disc_size.store(size, std::memory_order_release);
+}
+
+void ppsspp_stream_abort_ipc() {
+	g_ipc_mailbox.abort_flag.store(1, std::memory_order_release);
+	g_ipc_mailbox.status.store(-3, std::memory_order_release);
+	g_ipc_mailbox.resp_futex.fetch_add(1, std::memory_order_acq_rel);
+	g_ipc_mailbox.req_futex.fetch_add(1, std::memory_order_acq_rel);
+#ifdef __EMSCRIPTEN__
+	emscripten_futex_wake((volatile void *)&g_ipc_mailbox.resp_futex, INT32_MAX);
+	emscripten_futex_wake((volatile void *)&g_ipc_mailbox.req_futex, INT32_MAX);
+#endif
+}
+
+} // extern "C"
