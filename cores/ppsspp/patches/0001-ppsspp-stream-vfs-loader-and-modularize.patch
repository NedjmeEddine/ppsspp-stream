+// Copyright (c) 2012- PPSSPP Project / PPSSPP-Stream Contributors.
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU General Public License as published by
+// the Free Software Foundation, version 2.0 or later versions.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "Common/CommonTypes.h"
+#include "Common/File/Path.h"
+#include "Core/Loaders.h"
+
+class WasmVfsFileLoader : public FileLoader {
+public:
+	explicit WasmVfsFileLoader(const Path &filename);
+	~WasmVfsFileLoader() override = default;
+
+	bool Exists() override;
+	bool ExistsFast() override { return Exists(); }
+	bool IsDirectory() override { return false; }
+	s64 FileSize() override;
+	Path GetPath() const override { return filename_; }
+	size_t ReadAt(s64 absolutePos, size_t bytes, size_t count, void *data, Flags flags = Flags::NONE) override;
+	void Cancel() override { cancelled_.store(true, std::memory_order_release); }
+
+private:
+	Path filename_;
+	std::atomic<bool> cancelled_{false};
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+uintptr_t ppsspp_stream_get_ipc_ptr();
+void ppsspp_stream_set_disc_size(uint64_t size);
+void ppsspp_stream_abort_ipc();
+
+#ifdef __cplusplus
+}
+#endif
